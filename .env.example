# GEMINI_API_KEY: required. Every model call in the pipeline goes through it.
# In AI Studio this is injected at runtime from the Secrets panel; locally, copy
# this file to .env and paste your key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: the URL this app is hosted at. Injected automatically on Cloud Run.
APP_URL="MY_APP_URL"

# PORT: defaults to 3000.
# PORT=3000
